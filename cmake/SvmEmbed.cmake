# Keep the patched emitter and its public headers together in the build tree.
function(_wa_swiftvm_wasm_overlay source binary)
    find_program(WA_SWIFTVM_PATCH_EXECUTABLE patch REQUIRED)
    set(backend "${source}/runtime/backend/wasm")
    set(patch "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../runtime/linker_ffi/svm_wasm_softmmu.patch")
    set(overlay "${binary}/source/runtime/backend/wasm")
    set(staging "${binary}/wasm-stage")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${patch}")
    file(MAKE_DIRECTORY "${staging}")
    get_target_property(sources svm_wasm SOURCES)
    file(GLOB headers CONFIGURE_DEPENDS "${backend}/*.h")
    set(files)
    set(overlaid_sources)
    foreach(original IN LISTS sources headers)
        get_filename_component(file "${original}" NAME)
        configure_file("${original}" "${staging}/${file}" COPYONLY)
        list(APPEND files "${file}")
        if(original IN_LIST sources)
            list(APPEND overlaid_sources "${overlay}/${file}")
        endif()
    endforeach()
    execute_process(COMMAND "${WA_SWIFTVM_PATCH_EXECUTABLE}" -p1 -f -F 0 -s
        WORKING_DIRECTORY "${staging}" INPUT_FILE "${patch}"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT status STREQUAL "0")
        message(FATAL_ERROR "Cannot prepare SwiftVM standalone SoftMMU emitter\n${output}${error}")
    endif()
    foreach(file IN LISTS files)
        configure_file("${staging}/${file}" "${overlay}/${file}" COPYONLY)
    endforeach()
    set_property(TARGET svm_wasm PROPERTY SOURCES "${overlaid_sources}")
    target_include_directories(svm_wasm BEFORE PUBLIC "${binary}/source")
endfunction()

# Import source lists without configuring SwiftVM's execution owners and tools.
function(_wa_embed_swiftvm)
    set(source "${SVM_SOURCE_DIR}/source")
    set(externals "${source}/runtime/externals")
    set(binary "${CMAKE_CURRENT_BINARY_DIR}/swiftvm")
    set(declarations "")
    foreach(file IN ITEMS CMakeLists.txt cmake/ArmNumeric.cmake
                          source/runtime/platform/wasm/compiler.cmake)
        file(READ "${SVM_SOURCE_DIR}/${file}" contents)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${SVM_SOURCE_DIR}/${file}")
        string(APPEND declarations "\n${contents}")
    endforeach()

    set(targets svm_base svm_ir svm_ir_optimize svm_vixl_exact svm_arm64_numeric svm_aarch64_decode
                svm_arm32_numeric svm_ir_direct svm_arm32_ir svm_arm64_ir svm_wasm)
    foreach(target IN LISTS targets)
        string(REGEX MATCH "add_library\\(${target} STATIC[^)]+\\)" declaration "${declarations}")
        string(REGEX MATCHALL "source/[A-Za-z0-9_./-]+\\.(cpp|cc)" sources "${declaration}")
        if(NOT sources)
            message(FATAL_ERROR "SwiftVM portable source list missing for ${target}")
        endif()
        list(TRANSFORM sources PREPEND "${SVM_SOURCE_DIR}/")
        add_library(${target} STATIC ${sources})
    endforeach()
    add_library(svm_system_query STATIC "${source}/runtime/platform/system_query.cpp")
    list(APPEND targets svm_system_query)

    if(NOT TARGET fmt::fmt)
        if(EXISTS "${externals}/fmt/CMakeLists.txt")
            set(FMT_DOC OFF)
            set(FMT_TEST OFF)
            set(FMT_INSTALL OFF)
            set(FMT_OS OFF)
            set(FMT_SYSTEM_HEADERS ON)
            add_subdirectory("${externals}/fmt" "${binary}/fmt" EXCLUDE_FROM_ALL)
            list(APPEND targets fmt)
            if(EMSCRIPTEN)
                # Bundled fmt 9 predates Clang's current consteval checks.
                target_compile_definitions(fmt PUBLIC FMT_CONSTEVAL=)
            endif()
        else()
            find_package(fmt CONFIG REQUIRED)
        endif()
    endif()
    if(NOT TARGET svm_softfloat_ext80)
        add_subdirectory("${externals}/SoftFloat-3e" "${binary}/softfloat" EXCLUDE_FROM_ALL)
        list(APPEND targets svm_softfloat_ext80)
    endif()

    foreach(target IN LISTS targets)
        if(target MATCHES "^svm_" AND NOT target STREQUAL "svm_softfloat_ext80")
            target_include_directories(${target} SYSTEM PUBLIC "${source}")
            target_compile_features(${target} PUBLIC cxx_std_20)
        endif()
        if(EMSCRIPTEN)
            target_compile_options(${target} PRIVATE -O3 -msimd128 -matomics -mbulk-memory
                $<$<COMPILE_LANGUAGE:CXX>:-fwasm-exceptions>)
            target_link_options(${target} INTERFACE -msimd128 -matomics -mbulk-memory -fwasm-exceptions)
        endif()
    endforeach()

    target_link_libraries(svm_base PUBLIC fmt::fmt)
    target_link_libraries(svm_ir_optimize PUBLIC svm_ir)
    target_include_directories(svm_vixl_exact SYSTEM PUBLIC "${externals}/vixl")
    target_compile_definitions(svm_vixl_exact PUBLIC VIXL_INCLUDE_TARGET_AARCH64)
    target_link_libraries(svm_arm64_numeric PRIVATE svm_softfloat_ext80 svm_vixl_exact)
    target_compile_definitions(svm_arm64_numeric PRIVATE LITTLEENDIAN=1 SOFTFLOAT_FAST_INT64=1
        SOFTFLOAT_BUILTIN_CLZ=1 FEXCORE_PRESERVE_ALL_ATTR= FEXCORE_HAS_PRESERVE_ALL_ATTR=0)
    target_link_libraries(svm_arm32_numeric PUBLIC svm_arm64_numeric)
    target_link_libraries(svm_aarch64_decode PUBLIC svm_vixl_exact)

    target_compile_definitions(svm_ir_direct PRIVATE SVM_EMBEDDED_ARM32=1)
    target_sources(svm_ir_direct PRIVATE "${source}/runtime/arch/x86/vector_crypto.cpp")
    target_link_libraries(svm_ir_direct PUBLIC svm_ir PRIVATE svm_arm64_numeric)
    target_link_libraries(svm_arm32_ir PUBLIC svm_ir PRIVATE svm_ir_direct svm_arm32_numeric)
    target_sources(svm_arm64_ir PRIVATE "${source}/runtime/frontend/arm64/interpreter.cpp")
    target_link_libraries(svm_arm64_ir PUBLIC svm_ir
        PRIVATE svm_aarch64_decode svm_ir_direct svm_arm64_numeric svm_system_query)
    target_link_libraries(svm_wasm PUBLIC svm_ir)
    _wa_swiftvm_wasm_overlay("${source}" "${binary}")
endfunction()

_wa_embed_swiftvm()
