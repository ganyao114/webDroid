+    internal fun showCountdown(seconds: Int) {
+        showTime(seconds / 3600, seconds / 60 % 60, seconds % 60)
+    }
+
+    private fun showTime(hours: Int, minutes: Int, seconds: Int) {
+        val uidm = UiDataModel.uiDataModel
+        val hoursText = uidm.getFormattedNumber(hours, 2)
+        val minutesText = uidm.getFormattedNumber(minutes, 2)
+        val secondsText = uidm.getFormattedNumber(seconds, 2)
+        val text = "$hoursText${context.getString(R.string.hours_label)} " +
+                "$minutesText${context.getString(R.string.minutes_label)} " +
+                "$secondsText${context.getString(R.string.seconds_label)}"
+        mTimeView.text = text
+        mTimeView.contentDescription = text
+    }
+
+    internal fun setInputEnabled(enabled: Boolean) {
+        for (key in mDigitViews) key.isEnabled = enabled
+        mDeleteView.isEnabled = enabled && hasValidInput()
+    }
+
+    internal fun resetCountdown() {
+        reset()
+        showCountdown(0)
+        setInputEnabled(true)
