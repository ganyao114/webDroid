+    void prepareWorker(Runnable onPrepared) {
+        Looper previousLooper = sDispatchingLooper;
+        Thread previous = ThreadContext.swap(mThread);
+        sDispatchingLooper = this;
+        try {
+            onPrepared.run();
+        } finally {
