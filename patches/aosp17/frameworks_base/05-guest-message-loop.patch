+    /** Dispatch the messages due in the host clock domain without blocking the frame pump. */
+    public int dispatchDueMessages(long now) {
+        if (mInLoop) {
+            return 0;
+        }
+        Looper previousLooper = sDispatchingLooper;
+        Thread previous = ThreadContext.swap(mThread);
+        sDispatchingLooper = this;
+        mInLoop = true;
+        mSlowDeliveryDetected = false;
+        try {
+            int count = 0;
+            while (count < 1000 && loopOnce(this, now, -1)) {
+                count++;
+            }
+            return count;
+        } finally {
+            mInLoop = false;
+            sDispatchingLooper = previousLooper;
+            ThreadContext.swap(previous);
+        }
+    }
+
+    /** Drive existing cooperative worker queues, then the main queue, once per frame. */
+    public static void dispatchAllDueMessages(long now) {
+        int count = sWorkers.size();
+        for (int i = 0; i < count; i++) {
+            Looper worker = sWorkers.get(i);
+            worker.dispatchDueMessages(now);
+            if (worker.isFinished()) {
+                sWorkers.remove(i--);
+                count--;
+            }
+        }
+        Looper main = getMainLooper();
+        if (main != null) {
+            main.dispatchDueMessages(now);
         }
     }
 
