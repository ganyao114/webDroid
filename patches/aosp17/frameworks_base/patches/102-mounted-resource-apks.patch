+    private static Resources forMountedApks(String[] paths, String locale, int dpi,
+            ApkAssets framework) throws IOException {
+        final ApkAssets[] owned = new ApkAssets[paths.length];
+        final Configuration config = new Configuration();
+        config.setToDefaults();
+        config.setLocale(java.util.Locale.forLanguageTag(locale));
+        config.densityDpi = dpi;
+        Resources result = null;
+        try {
+            for (int i = 0; i < paths.length; ++i) owned[i] = ApkAssets.loadFromPath(paths[i]);
+            final ApkAssets[] assets;
+            if (framework != null) {
+                assets = new ApkAssets[owned.length + 1];
+                assets[0] = framework;
+                System.arraycopy(owned, 0, assets, 1, owned.length);
+            } else {
+                assets = owned;
+            }
+            result = forAssets(assets, new DisplayMetrics(), config);
+            result.mOwnedApks = owned;
+            if (framework == null && assets.length > 1
+                    && "android".equals(result.getResourcePackageName(android.R.string.ok))) {
+                result.mMountedSystem = forAssets(new ApkAssets[] {assets[0]}, new DisplayMetrics(), config);
+                synchronized (sSync) {
+                    mSystem = result.mMountedSystem;
+                }
+            }
+            return result;
+        } catch (IOException | RuntimeException | Error failure) {
+            if (result != null) result.close();
+            else for (ApkAssets apk : owned) if (apk != null) apk.close();
+            throw failure;
+        }
+    }
+
+    private static Resources forAssets(ApkAssets[] assets, DisplayMetrics metrics, Configuration config) {
+        final AssetManager manager = AssetManager.forMountedApks(assets);
+        try {
+            final Resources resources = new Resources(manager, metrics, config);
+            resources.mOwnedAssets = manager;
+            return resources;
+        } catch (RuntimeException | Error failure) {
+            manager.close();
+            throw failure;
+        }
+    }
