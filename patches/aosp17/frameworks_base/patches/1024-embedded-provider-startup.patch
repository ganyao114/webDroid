+    private static Bundle parseMetaData(Bundle data, Resources res, XmlResourceParser parser) {
+        try (TypedArray sa = res.obtainAttributes(parser, R.styleable.AndroidManifestMetaData)) {
+            String name = sa.getString(R.styleable.AndroidManifestMetaData_name);
+            if (name == null) return data;
+            if (data == null) data = new Bundle();
+            int resource = sa.getResourceId(R.styleable.AndroidManifestMetaData_resource, 0);
+            if (resource != 0) {
+                data.putInt(name, resource);
+                return data;
+            }
+            TypedValue value = sa.peekValue(R.styleable.AndroidManifestMetaData_value);
+            if (value == null) return data;
+            if (value.type == TypedValue.TYPE_STRING) {
+                data.putString(name, value.coerceToString().toString());
+            } else if (value.type == TypedValue.TYPE_INT_BOOLEAN) {
+                data.putBoolean(name, value.data != 0);
+            } else if (value.type >= TypedValue.TYPE_FIRST_INT && value.type <= TypedValue.TYPE_LAST_INT) {
+                data.putInt(name, value.data);
+            } else if (value.type == TypedValue.TYPE_FLOAT) {
+                data.putFloat(name, value.getFloat());
+            }
+            return data;
         }
