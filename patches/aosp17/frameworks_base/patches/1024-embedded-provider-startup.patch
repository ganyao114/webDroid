+    private static PatternMatcher parsePattern(TypedArray sa, int advanced, int glob,
+            int prefix, int suffix, int literal) {
+        // A pattern takes precedence over prefix/suffix and literal paths.
+        String path = sa.getString(advanced);
+        if (path != null) return new PatternMatcher(path, PatternMatcher.PATTERN_ADVANCED_GLOB);
+        path = sa.getString(glob);
+        if (path != null) return new PatternMatcher(path, PatternMatcher.PATTERN_SIMPLE_GLOB);
+        path = sa.getString(prefix);
+        if (path != null) return new PatternMatcher(path, PatternMatcher.PATTERN_PREFIX);
+        path = sa.getString(suffix);
+        if (path != null) return new PatternMatcher(path, PatternMatcher.PATTERN_SUFFIX);
+        path = sa.getString(literal);
+        return path == null ? null : new PatternMatcher(path, PatternMatcher.PATTERN_LITERAL);
+    }
