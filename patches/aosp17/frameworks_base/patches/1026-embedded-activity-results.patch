+    private boolean enqueueEmbeddedLaunch(Intent intent, int requestCode) {
+        if (!Boolean.getBoolean("org.wasmandroid.foreground")) return false;
+        ComponentName name = intent.getComponent();
+        if (name == null || !getPackageName().equals(name.getPackageName())) return false;
+        if (getPackageManager().resolveActivity(intent, 0) == null) {
+            throw new ActivityNotFoundException(intent.toString());
+        }
+        mEmbeddedLaunches.add(new EmbeddedLaunch(intent, requestCode));
+        return true;
+    }
+
+    final EmbeddedLaunch pollEmbeddedLaunch() {
+        return mEmbeddedLaunches.isEmpty() ? null : mEmbeddedLaunches.remove(0);
+    }
