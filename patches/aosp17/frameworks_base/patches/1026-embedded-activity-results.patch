+    static final class EmbeddedLaunch {
+        final Intent intent;
+        final int requestCode;
+
+        EmbeddedLaunch(Intent intent, int requestCode) {
+            this.intent = new Intent(intent);
+            this.requestCode = requestCode;
+        }
