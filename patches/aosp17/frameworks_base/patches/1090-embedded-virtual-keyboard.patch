+    private static final class Behavior {
+        final int modifiers;
+        final char character;
+        final int fallback;
+
+        Behavior(int modifiers, char character) {
+            this(modifiers, character, KeyEvent.KEYCODE_UNKNOWN);
+        }
+
+        Behavior(int modifiers, char character, int fallback) {
+            this.modifiers = modifiers;
+            this.character = character;
+            this.fallback = fallback;
+        }
+
+        boolean matches(int metaState) {
+            return (metaState & modifiers) == modifiers
+                    && (metaState & MODIFIER_MASK) == (modifiers & MODIFIER_MASK);
+        }
+    }
