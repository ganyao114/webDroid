+    private void embeddedDocumentResult(int requestCode, String[] paths, String type) {
+        if (isFinishing()) return;
+        if (paths == null || paths.length == 0) {
+            onActivityResult(requestCode, RESULT_CANCELED, null);
+            return;
+        }
+        Uri first = Uri.fromFile(new java.io.File(paths[0]));
+        Intent result = new Intent().setDataAndType(first, type)
+                .addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION);
+        if (paths.length > 1) {
+            android.content.ClipData clip = android.content.ClipData.newRawUri("", first);
+            for (int i = 1; i < paths.length; i++) {
+                Uri next = Uri.fromFile(new java.io.File(paths[i]));
+                clip.addItem(new android.content.ClipData.Item(next));
+            }
+            result.setClipData(clip);
+        }
+        onActivityResult(requestCode, RESULT_OK, result);
