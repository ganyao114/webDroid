+    private static void writeSplitDependencies(Parcel dest, SparseArray<int[]> dependencies) {
+        if (dependencies == null) {
+            dest.writeInt(-1);
+            return;
+        }
+        dest.writeInt(dependencies.size());
+        for (int i = 0; i < dependencies.size(); i++) {
+            dest.writeInt(dependencies.keyAt(i));
+            dest.writeIntArray(dependencies.valueAt(i));
+        }
+    }
+
+    private static SparseArray<int[]> readSplitDependencies(Parcel source) {
+        final int size = source.readInt();
+        if (size < 0) return null;
+        final SparseArray<int[]> dependencies = new SparseArray<>(size);
+        for (int i = 0; i < size; i++) {
+            dependencies.append(source.readInt(), source.createIntArray());
+        }
+        return dependencies;
+    }
