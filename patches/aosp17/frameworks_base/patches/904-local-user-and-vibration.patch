-        if (accountName != null) {
-            intent.putExtra(EXTRA_USER_ACCOUNT_NAME, accountName);
-        }
-        if (accountType != null) {
-            intent.putExtra(EXTRA_USER_ACCOUNT_TYPE, accountType);
