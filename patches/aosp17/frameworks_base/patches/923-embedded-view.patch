+            Rect bounds = mTransform.getOutlineBounds();
+            if (outline.getRect(bounds)) {
+                final float radius = outline.getRadius();
+                if (radius == 0f) {
+                    canvas.clipRect(bounds);
+                } else {
+                    canvas.clipRoundRect(bounds.left, bounds.top, bounds.right, bounds.bottom,
+                            radius, radius);
