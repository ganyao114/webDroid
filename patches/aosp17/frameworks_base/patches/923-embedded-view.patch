+        private Matrix updateMatrix() {
+            final int width = mView.getWidth();
+            final int height = mView.getHeight();
+            if (mMatrix == null) mMatrix = new Matrix();
+            if (!mMatrixDirty && (mPivotSet || (width == mMatrixWidth && height == mMatrixHeight))) {
+                return mMatrix;
+            }
+            mMatrixWidth = width;
+            mMatrixHeight = height;
+            mMatrixDirty = false;
+
+            final float x = getPivotX();
+            final float y = getPivotY();
+            if (mRotationX == 0f && mRotationY == 0f) {
+                mMatrix.setScale(mScaleX, mScaleY, x, y);
+                if (mRotationZ != 0f) mMatrix.postRotate(mRotationZ, x, y);
+                if (mTranslationX != 0f || mTranslationY != 0f) {
+                    mMatrix.postTranslate(mTranslationX, mTranslationY);
+                }
+            } else {
+                setPerspectiveMatrix(x, y);
+            }
+            if (mAnimationMatrix != null) mMatrix.postConcat(mAnimationMatrix);
+            return mMatrix;
+        }
+
+        private void setPerspectiveMatrix(float x, float y) {
+            final double rx = Math.toRadians(mRotationX);
+            final double ry = Math.toRadians(mRotationY);
+            final double rz = Math.toRadians(mRotationZ);
+            final float cx = (float) Math.cos(rx), sx = (float) Math.sin(rx);
+            final float cy = (float) Math.cos(ry), sy = (float) Math.sin(ry);
+            final float cz = (float) Math.cos(rz), sz = (float) Math.sin(rz);
+            final float a = cz * cy * mScaleX;
+            final float b = (cz * sy * sx - sz * cx) * mScaleY;
+            final float c = sz * cy * mScaleX;
+            final float d = (sz * sy * sx + cz * cx) * mScaleY;
+            final float distance = Math.max(1f, mCameraDistance * 72f);
+            final float p = sy * mScaleX / distance;
+            final float q = -cy * sx * mScaleY / distance;
+            mMatrix.setValues(new float[] {
+                    a, b, 0f,
+                    c, d, 0f,
+                    p, q, 1f
+            });
+            mMatrix.preTranslate(-x, -y);
+            mMatrix.postTranslate(x + mTranslationX, y + mTranslationY);
+        }
