+    /** @hide Applies browser IME updates to the same Editable observed by TextWatchers. */
+    @Override
+    public boolean onImeText(CharSequence value, boolean composing) {
+        Editable text = getEditableText();
+        if (text == null || !isEnabled() || !onCheckIsTextEditor()) return false;
+        int start = text.getSpanStart(IME_COMPOSING_SPAN);
+        int end = text.getSpanEnd(IME_COMPOSING_SPAN);
+        if (start < 0 || end < 0) {
+            start = Math.max(0, Math.min(getSelectionStart(), getSelectionEnd()));
+            end = Math.max(start, Math.max(getSelectionStart(), getSelectionEnd()));
+        }
+        clearComposingText();
+        beginBatchEdit();
+        try {
+            if (composing) {
+                text.setSpan(IME_COMPOSING_SPAN, start, end,
+                        Spanned.SPAN_INCLUSIVE_INCLUSIVE | Spanned.SPAN_COMPOSING);
+            }
+            // Let Editable track these positions across input filters and TextWatcher changes.
+            Selection.setSelection(text, end);
+            text.replace(start, end, value);
+            if (composing) {
+                start = text.getSpanStart(IME_COMPOSING_SPAN);
+                end = text.getSpanEnd(IME_COMPOSING_SPAN);
+                if (start >= 0 && start < end) {
+                    text.setSpan(IME_COMPOSING_SPAN, start, end,
+                            Spanned.SPAN_EXCLUSIVE_EXCLUSIVE | Spanned.SPAN_COMPOSING);
+                } else {
+                    text.removeSpan(IME_COMPOSING_SPAN);
+                }
+            }
+        } finally {
+            endBatchEdit();
+        }
+        return true;
+    }
+
+    private void deleteFromCursor(Editable text, boolean backward) {
+        clearComposingText();
+        int start = Math.max(0, Math.min(getSelectionStart(), getSelectionEnd()));
+        int end = Math.max(start, Math.max(getSelectionStart(), getSelectionEnd()));
+        if (start == end) {
+            if (backward && start > 0) start = TextUtils.getOffsetBefore(text, start);
+            if (!backward && end < text.length()) end = TextUtils.getOffsetAfter(text, end);
+        }
+        if (start < end) {
+            Selection.setSelection(text, start);
+            text.delete(start, end);
+        }
+    }
 
