+    // The embedded GridView owns scrolling and reuses rows. AndroidX still flattens the hierarchy,
+    // inflates each row's layout, and binds the original Preference and its click listener.
+    private static final class PreferenceListAdapter extends BaseAdapter {
+        private final PreferenceGroupAdapter mRows;
+        private final ArrayList<Integer> mPositions = new ArrayList<>();
+
+        PreferenceListAdapter(PreferenceScreen screen) {
+            mRows = new PreferenceGroupAdapter(screen);
+            for (int i = 0; i < mRows.getItemCount(); i++) {
+                final Preference row = mRows.getItem(i);
+                if (!(row instanceof PreferenceCategory) || !TextUtils.isEmpty(row.getTitle())) {
+                    mPositions.add(i);
+                }
+            }
+        }
+
+        @Override
+        public int getCount() {
+            return mPositions.size();
+        }
+
+        @Override
+        public Preference getItem(int position) {
+            return mRows.getItem(mPositions.get(position));
+        }
+
+        @Override
+        public long getItemId(int position) {
+            return mRows.getItemId(mPositions.get(position));
+        }
+
+        @Override
+        public View getView(int position, View recycled, ViewGroup parent) {
+            final int row = mPositions.get(position);
+            final int type = mRows.getItemViewType(row);
+            final PreferenceViewHolder holder;
+            if (recycled != null && recycled.getTag() instanceof BoundRow
+                    && ((BoundRow) recycled.getTag()).type == type) {
+                holder = ((BoundRow) recycled.getTag()).holder;
+            } else {
+                holder = mRows.onCreateViewHolder(parent, type);
+                holder.itemView.setTag(new BoundRow(type, holder));
+            }
+            mRows.onBindViewHolder(holder, row);
+            return holder.itemView;
+        }
+
+        private static final class BoundRow {
+            final int type;
+            final PreferenceViewHolder holder;
+
+            BoundRow(int type, PreferenceViewHolder holder) {
+                this.type = type;
+                this.holder = holder;
+            }
+        }
+    }
+
+    private void preparePreferences(PreferenceGroup group) {
+        // Controllers and destination classes are optional on the single-window appliance.
+        for (int i = 0; i < group.getPreferenceCount(); i++) {
+            final Preference preference = group.getPreference(i);
+            if (preference instanceof PreferenceGroup) {
+                preparePreferences((PreferenceGroup) preference);
+            } else {
+                preference.setPersistent(false);
+                preference.setCopyingEnabled(false);
+                final String fragment = preference.getFragment();
+                if (fragment != null) {
+                    try {
+                        Class.forName(fragment, false, requireContext().getClassLoader());
+                    } catch (ClassNotFoundException missing) {
+                        preference.setFragment(null);
                     }
-                });
+                }
+                preference.setIntent(null);
+                preference.setSelectable(preference.getFragment() != null);
+            }
+        }
+    }
