+    }
+
+    private void updateHeader() {
+        final boolean home = mPages.size() == 1;
+        final boolean showQuery = home && mSearching;
+        if (!showQuery) mQuery.clearFocus();
+        mQuery.setVisibility(showQuery ? View.VISIBLE : View.GONE);
+        mTitle.setVisibility(showQuery ? View.GONE : View.VISIBLE);
+        mTitle.setText(mPages.getLast().title);
+        mSearchIcon.setVisibility(home ? View.VISIBLE : View.GONE);
+        mSearchBar.setClickable(home);
+    }
+
+    private PageEntry createPage(DashboardFragment fragment, CharSequence title) {
+        View view = null;
+        try {
+            fragment.onAttach((Context) this);
+            fragment.onCreate(null);
+            view = fragment.onCreateView(getLayoutInflater(), mContent, null);
+            fragment.onViewCreated(view, null);
+            fragment.onResume();
+            return new PageEntry(fragment, view, title);
+        } catch (RuntimeException | LinkageError failure) {
+            if (view != null) fragment.onDestroyView();
+            fragment.onDestroy();
+            fragment.onDetach();
+            throw failure;
+        }
+    }
+
+    private void closePage(PageEntry page) {
+        page.fragment.onDestroyView();
+        page.fragment.onDestroy();
+        page.fragment.onDetach();
     }
 }
