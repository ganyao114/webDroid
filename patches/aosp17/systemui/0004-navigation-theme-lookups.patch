+    private static int getHomeHandleColor(Context context, int themeAttr) {
+        final TypedArray theme = context.obtainStyledAttributes(new int[] {themeAttr});
+        final int style = theme.getResourceId(0, 0);
+        theme.recycle();
+        final Context themed = new ContextThemeWrapper(context, style);
+        final TypedArray color = themed.obtainStyledAttributes(new int[] {R.attr.homeHandleColor});
+        final int value = color.getColor(0, 0);
+        color.recycle();
+        return value;
     }
 
