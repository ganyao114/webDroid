+
+    private void updateSignal(View group, int id, int[] icons, int level) {
+        group.setVisibility(level < 0 ? GONE : VISIBLE);
+        if (level >= 0) {
+            ImageView signal = group.findViewById(id);
+            int icon = icons[Math.min(level, icons.length - 1)];
+            if (signal.getTag() == null || ((Integer) signal.getTag()) != icon) {
+                signal.setImageResource(icon);
+                signal.getDrawable().setTint(DarkIconDispatcher.DEFAULT_ICON_TINT);
+                signal.setTag(icon);
+            }
+        }
+    }
